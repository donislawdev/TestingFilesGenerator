/* What Windows shows in the Details tab of tfg.exe.
 *
 * Without this the file has no description, no version and no author, so
 * Explorer lists it as a bare name and anybody auditing what is running on a
 * build agent has nothing to read. A command line tool is exactly the kind of
 * binary somebody finds later and has to identify.
 *
 * The numbers are NOT authored here. The version is the one in
 * internal/version, which is the single place it lives and the only place the
 * owner sets it - untouchable rule 12. This file is a copy of it, and a copy is
 * a thing that drifts, so a guard reads the compiled resource back and holds it
 * against internal/version rather than against this text.
 *
 * FILEVERSION takes four numbers and a semantic version has three, so the
 * fourth is zero rather than a build counter. A build counter would move
 * without anybody deciding it had, which is what rule 12 is about.
 *
 * Regenerated by hand, on Windows, with the compiler the window already needs:
 *
 *   windres -i cmd/tfg/tfg.rc -O coff -o cmd/tfg/rsrc_windows_amd64.syso
 *
 * The .syso is committed rather than built, because the Go toolchain links any
 * .syso it finds in the main package and runs no generator of its own. The name
 * carries GOOS and GOARCH, so every other platform ignores it instead of
 * failing over it. Nothing here needs a C compiler at BUILD time: this file is
 * turned into the .syso once, by hand, and the command line still builds with
 * CGO off and no toolchain beyond Go.
 *
 * The icon is the window's own, reached across the tree rather than copied
 * beside this file. One drawing means one thing to regenerate when it changes,
 * and two copies of an .ico is how the two binaries end up wearing different
 * pictures of the same bean.
 *
 * Added on 2026-08-19, reported from Explorer: a binary with no icon gets the
 * blank placeholder Windows draws for anything it cannot identify, and it sat
 * next to a window binary that had one. Resource id 1, because Windows shows
 * the lowest numbered icon in a binary as that binary's icon.
 */
1 ICON "../../internal/gui/icon/chickpea.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DonislawDev"
            VALUE "FileDescription", "Generates test files for QA, from the command line"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "tfg"
            VALUE "LegalCopyright", "Copyright (C) 2026 DonislawDev. GNU GPL version 3."
            VALUE "OriginalFilename", "tfg.exe"
            VALUE "ProductName", "Testing Files Generator"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        /* US English, and the Unicode code page. Both halves are needed: a
         * reader that finds no matching translation shows nothing at all. */
        VALUE "Translation", 0x409, 1200
    END
END
