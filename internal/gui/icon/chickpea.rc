/* The Windows resource script the taskbar icon is built from.
 *
 * Two icons live in this program and they come from different places. The
 * toolkit is handed a picture for the window by app.SetIcon, and that covers
 * the frame and the switcher. The taskbar button and File Explorer read a
 * resource compiled into the exe instead, and a binary without one gets the
 * placeholder Windows draws for anything it cannot identify. Reported from a
 * real taskbar on 2026-08-13.
 *
 * Resource id 1, because Windows shows the lowest numbered icon in a binary as
 * that binary's icon.
 *
 * Regenerated by hand, on Windows, with the compiler the window already needs:
 *
 *   python tools/appicon.py --ico internal/gui/icon/chickpea.ico
 *   windres -i internal/gui/icon/chickpea.rc -O coff \
 *           -o cmd/tfg-gui/rsrc_windows_amd64.syso
 *
 * The .syso is committed rather than built, because the Go toolchain links any
 * .syso it finds in the main package and runs no generator of its own. The
 * name carries GOOS and GOARCH, so every other platform ignores the file
 * instead of failing over it.
 */
1 ICON "chickpea.ico"

/* And what Windows shows in the Details tab of tfg-gui.exe.
 *
 * Beside the icon rather than in a file of its own, because both are resources
 * of the same binary and windres builds one .syso from one script. Two scripts
 * would mean two commands to remember and one of them getting forgotten.
 *
 * The version is NOT authored here. It is the one in internal/version, the
 * single place it lives and the only place the owner sets it - untouchable rule
 * 12 - and this is a copy. A guard reads the compiled resource back and holds
 * it against internal/version, because a copy is a thing that drifts.
 *
 * See cmd/tfg/tfg.rc for the same block on the command line binary, and for why
 * the fourth number of FILEVERSION is a zero rather than a build counter.
 */
1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DonislawDev"
            VALUE "FileDescription", "Generates test files for QA"
            VALUE "FileVersion", "0.3.0-rc1"
            VALUE "InternalName", "tfg-gui"
            VALUE "LegalCopyright", "Copyright (C) 2026 DonislawDev. GNU GPL version 3."
            VALUE "OriginalFilename", "tfg-gui.exe"
            VALUE "ProductName", "Testing Files Generator"
            VALUE "ProductVersion", "0.3.0-rc1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
